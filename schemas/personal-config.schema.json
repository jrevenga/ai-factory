{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "profile": {
      "type": "string"
    },
    "autonomy": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "parallelism": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "language": {
      "type": "string"
    },
    "radar": {
      "type": "boolean"
    },
    "maintainer": {
      "type": "boolean"
    },
    "gates": {
      "type": "object",
      "properties": {
        "soften": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "design-approval",
                  "new-dependency",
                  "design-deviation",
                  "review-disagreement",
                  "quota-low"
                ]
              },
              {
                "type": "string"
              }
            ]
          }
        }
      },
      "additionalProperties": {}
    },
    "budgets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "weeklyTokens": {
            "type": "number"
          }
        },
        "additionalProperties": {}
      }
    },
    "machine": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "eval": {
      "type": "object",
      "properties": {
        "tokenBudget": {
          "type": "object",
          "properties": {
            "claude": {
              "type": "number"
            },
            "codex": {
              "type": "number"
            }
          },
          "additionalProperties": {}
        },
        "quotaStopAt": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema",
    "profile"
  ],
  "additionalProperties": {}
}
