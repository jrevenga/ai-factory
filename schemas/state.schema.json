{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "installedAt": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "piVersion": {
      "type": "string"
    },
    "piCli": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "install",
                  "update",
                  "rollback"
                ]
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "version",
          "at",
          "reason"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schema",
    "version",
    "installedAt",
    "source",
    "piVersion",
    "piCli",
    "history"
  ],
  "additionalProperties": {}
}
