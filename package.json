{
  "name": "ai-factory",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "factory": "bin/factory.mjs"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/adapters/pi/extension/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && node --import jiti/register scripts/check-layers.ts",
    "test": "vitest run --exclude \"test/e2e/**\"",
    "test:e2e": "vitest run test/e2e"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0"
  },
  "dependencies": {
    "jiti": "2.7.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
